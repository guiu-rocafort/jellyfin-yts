<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Plugin.YtsTorrents</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.YtsTorrents</RootNamespace>
    <!-- Without this, the assembly gets no version at all and Jellyfin's dashboard shows the plugin
         as "0.0.0.0", looking broken/unfinished next to every other plugin's real version. Keep in
         sync with meta.json.template's "version" field. -->
    <Version>0.2.0.0</Version>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the Jellyfin server at runtime; only needed at compile time. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for ControllerBase / [ApiController] / [Authorize] which Jellyfin's own host provides at runtime. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\browsePage.html" />
  </ItemGroup>

</Project>
